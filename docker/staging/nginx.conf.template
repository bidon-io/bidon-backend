server {
    listen 80;

    location / {
        proxy_pass             ${SPACES_FRONTEND_ORIGIN}/;
        proxy_ssl_server_name  on;
        proxy_intercept_errors on;
        error_page 404 = @spa_fallback;
    }

    # Serve index.html for any path the SPA router owns (client-side routing).
    location @spa_fallback {
        proxy_pass            ${SPACES_FRONTEND_ORIGIN}/index.html;
        proxy_ssl_server_name on;
    }
}
