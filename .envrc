# Loads Nix flake
use flake

# git-spice (`gs`) keeps its own token store and never reads gh's keyring, and `gs auth login`
# doesn't stick on our machines — hand it gh's token instead so `gs` commands just work.
export GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"

# Checks if .env.local is up to date, and loads it
just config-diff
dotenv .env.local
