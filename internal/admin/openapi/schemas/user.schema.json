{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.schema.json",
  "title": "User",
  "allOf": [
    {
      "$ref": "./user-props.schema.json"
    },
    {
      "type": "object",
      "required": ["email"]
    },
    {
      "type": "object",
      "properties": {
        "_permissions": {
          "$ref": "resource-instance-permissions.schema.json",
          "description": "Permissions for the current user on this user instance"
        }
      }
    }
  ]
}
