{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demand-source.schema.json",
  "title": "DemandSource",
  "allOf": [
    {
      "$ref": "./demand-source-props.schema.json"
    },
    {
      "type": "object",
      "required": ["human_name", "api_key"]
    },
    {
      "type": "object",
      "properties": {
        "_permissions": {
          "$ref": "resource-instance-permissions.schema.json",
          "description": "Permissions for the current user on this demand source instance"
        }
      }
    }
  ]
}
