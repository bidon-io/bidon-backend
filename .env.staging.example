# Staging environment — configure in Coolify (http://coolify.bidon.squads.com/)
# Copy to .env.staging for local reference or bidon-coolify --env-file usage.

# DB connection for compose → DATABASE_URL / DATABASE_REPLICA_URL.
# Hosted staging: managed URI (terraform output -raw db_app_private_uri).
# Coolify previews: omit this var (compose default uses ${SERVICE_NAME_POSTGRES}).
# Do not hardcode @postgres in preview — Coolify renames services to *-pr-N.
STAGING_DATABASE_URL=postgres://bidon:password@host:25060/bidon?sslmode=require

# Application secrets
APP_SECRET=
SUPERUSER_LOGIN=
SUPERUSER_PASSWORD=

# Docker image tags — set to the git SHA from `just ci-build-*` (or a CI build tag).
# Keep tags in sync across services; an older BIDON_UI_TAG is a common cause of admin UI
# missing new networks even when backend/seed images are already updated.
BIDON_ADMIN_TAG=
BIDON_SDKAPI_TAG=
BIDON_MIGRATE_TAG=
BIDON_SEED_TAG=
BIDON_UI_TAG=
