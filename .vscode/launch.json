{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug tests",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "env": {
        "DATABASE_URL": "postgres://bidon:pass@localhost:5435/bidon_test",
        "DATABASE_REPLICA_URL": "postgres://bidon:pass@localhost:5435/bidon_test"
      },
      "program": "${fileDirname}"
    },
    {
      "name": "bidon-sdkapi",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": ".",
      "program": "cmd/bidon-sdkapi",
    },
    {
      "name": "bidon-admin",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": ".",
      "program": "cmd/bidon-admin",
    },
    {
      "name": "Debug Rust tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run"],
        "filter": {
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "bidon-proxy",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=bidon-proxy"
        ]
      },
      "args": []
    },
  ]
}
